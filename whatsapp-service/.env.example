# Port this sidecar listens on. Must match WHATSAPP_WEB_URL in backend/.env
PORT=3001

# Shared secret the FastAPI backend sends as the x-api-key header.
# Must match WHATSAPP_WEB_API_KEY in backend/.env. Leave blank only in local dev.
WHATSAPP_API_KEY=change-me-to-a-long-random-string

# Where the linked-device session is persisted. Deleting this forces a re-scan.
SESSION_DIR=./.wwebjs_auth

# Country code prepended to bare 10-digit numbers.
DEFAULT_COUNTRY_CODE=91

# Optional: Residential/Datacenter Outbound Proxy for WhatsApp WebSocket Gateway
# Option A: Full connection URL
# PROXY_URL=http://username:password@proxy-host.com:port
# PROXY_URL=socks5://username:password@proxy-host.com:port

# Option B: Discrete credentials (used if PROXY_URL is not set)
# PROXY_PROTOCOL=http        # 'http', 'https', or 'socks5' (default: http)
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=
