APP_NAME="Agrawal Samaj Portal"
ENVIRONMENT=development
SECRET_KEY="super-secret-development-key-that-is-very-long-and-secure"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Shared secret required on POST /auth/register/oauth (header X-Internal-Secret).
# Must match INTERNAL_API_SECRET in frontend/.env.local exactly.
INTERNAL_API_SECRET=4ad5e6854338ee5889b4dd17a316dfcf6b1490db8fd7ebd9a5356fb4a0272844

# Database Connection (To use Postgres: postgresql+asyncpg://user:password@localhost:5432/db_name)
DATABASE_URL=sqlite+aiosqlite:///./test.db

# MinIO / Object Storage Config (optional for initial phases)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=samaj-media

# Razorpay Config (optional for initial phases)
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret

# Twilio Config — used for SMS OTP only. WhatsApp delivery no longer uses
# Twilio; see WHATSAPP_PROVIDER / whatsapp-service below.
TWILIO_ACCOUNT_SID=AC6cdf06baa6695dc200a51f8f02486cfd
TWILIO_AUTH_TOKEN=94230a4cb91a5c7a51fb7a7ef95f4062
TWILIO_PHONE_NUMBER=+16513602733

# SMS OTP Login Configuration
# Options: dummy, twilio, msg91, android_gateway
SMS_PROVIDER=twilio
SMS_API_KEY=dummy_key
SMS_SENDER_ID=SAMAJ
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=50
OTP_RESEND_COOLDOWN_SECONDS=30

# Public base URLs. Set these to the LAN IP (not localhost) when serving over a
# network, otherwise pass QR codes encode a link that only works on this machine.
# Change both if your DHCP address changes.
# Both point at the Next origin, which proxies /api/v1, /static and /uploads
# through to this backend (see frontend/next.config.ts). One origin => the QR
# scanner gets its HTTPS secure context and pass images are not mixed content.
DOMAIN_URL=https://10.1.0.13:3000
FRONTEND_URL=https://10.1.0.13:3000

# WhatsApp pass/receipt delivery: 'whatsapp_web' | 'dummy' (dummy just logs)
WHATSAPP_PROVIDER=whatsapp_web

# whatsapp-web.js sidecar — start it with: cd whatsapp-service && npm start
WHATSAPP_WEB_URL=http://localhost:3001
# Must match WHATSAPP_API_KEY in whatsapp-service/.env (that file didn't exist
# until now, so this key was never actually being checked by the sidecar).
WHATSAPP_WEB_API_KEY=3b84e9e4b2cb15d3b324602ea6582d577d6723fb81831bbb38368cefacbdbb4e
WHATSAPP_WEB_TIMEOUT=60

# Custom Android HTTP SMS Gateway (Alternative to Twilio/MSG91)
# SMS_GATEWAY_URL=http://<YOUR_PHONE_IP>:8080/send

# Email OTP Login Configuration (Gmail SMTP)
FROM_EMAIL=gattubaba00@gmail.com
