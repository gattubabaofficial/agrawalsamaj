APP_NAME="Agrawal Samaj Portal"
ENVIRONMENT=development
SECRET_KEY="super-secret-development-key-that-is-very-long-and-secure"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (To use Postgres: postgresql+asyncpg://user:password@localhost:5432/db_name)
DATABASE_URL=sqlite+aiosqlite:///./test.db

# MinIO / Object Storage Config (optional for initial phases)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=samaj-media

# Razorpay Config (optional for initial phases)
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret

# Twilio Config (optional for initial phases)
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_PHONE_NUMBER=your_number

# SMS OTP Login Configuration
SMS_PROVIDER=msg91
SMS_API_KEY=dummy_key
SMS_SENDER_ID=SAMAJ
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Email OTP Login Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dummy@gmail.com
SMTP_APP_PASSWORD=dummy_app_password
EMAIL_FROM_NAME="Agrawal Samaj"
